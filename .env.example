# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# The web app and the bot both read this file (via the shared db package).
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Start on SQLite (zero setup). To move to Postgres later, change the
# datasource provider in prisma/schema.prisma to "postgresql" and set this to
# a postgres:// URL — nothing else changes.
DATABASE_URL="file:./prisma/dev.db"

# Discord application --------------------------------------------------------
# Create an app at https://discord.com/developers/applications
# OAuth2 -> Client ID / Client Secret (used by the web app's "Login with Discord")
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Bot -> Token (used by the discord.js bot process)
DISCORD_BOT_TOKEN=""

# The ID of your club's Discord server (right-click server -> Copy Server ID,
# with Developer Mode enabled). Used to register slash commands instantly.
DISCORD_GUILD_ID=""

# Auth.js (web app) ----------------------------------------------------------
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of the web app. Locally this is http://localhost:3000
# In production set it to your Cloudflare Tunnel URL, e.g. https://club.example.com
AUTH_URL="http://localhost:3000"

# Google Drive (Phase 3 — leave blank until then) ---------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_ID=""

# Claude API (Phase 5 — leave blank until then) -----------------------------
ANTHROPIC_API_KEY=""
