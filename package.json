{
  "name": "club-app",
  "version": "0.1.0",
  "private": true,
  "description": "Club web app + Discord bot over a shared database.",
  "workspaces": [
    "packages/*",
    "web",
    "bot"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "web:dev": "npm run dev --workspace web",
    "bot:dev": "npm run dev --workspace bot",
    "bot:deploy": "npm run deploy --workspace bot"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "typescript": "^5.7.2"
  }
}
